# Copy to .env and fill in values for your chosen payment provider
# Default is "stub" (no-op) — safe for development

VITE_PAYMENT_PROVIDER=stub

# --- Stripe ---
# VITE_PAYMENT_PROVIDER=stripe
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Requires: Netlify Function at /api/create-checkout-session

# --- Quickpay (popular in Denmark) ---
# VITE_PAYMENT_PROVIDER=quickpay
# VITE_QUICKPAY_API_KEY=...
# VITE_QUICKPAY_MERCHANT_ID=...

# --- MobilePay (online, via Stripe or Quickpay gateway) ---
# MobilePay does NOT support deep-links for merchant payments.
# Use MobilePay as a payment method inside Stripe or Quickpay — not standalone.
